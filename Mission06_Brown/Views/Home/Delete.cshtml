@model Mission06_Brown.Models.Movie

@{
    ViewData["Title"] = "Delete Movie";
}

<h1 class="display-4 text-center text-danger">Delete Movie</h1>
<hr />

<div class="alert alert-warning" role="alert">
    <strong>Warning!</strong> Are you sure you want to delete this movie? This action cannot be undone.
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">@Model.Title</h5>
                <p class="card-text">
                    <strong>Year:</strong> @Model.Year<br />
                    <strong>Director:</strong> @(Model.Director ?? "N/A")<br />
                    <strong>Category:</strong> @(Model.Category?.CategoryName ?? "N/A")<br />
                    <strong>Rating:</strong> @(Model.Rating ?? "N/A")<br />
                    <strong>Edited:</strong> @(Model.Edited ? "Yes" : "No")<br />
                    <strong>Copied to Plex:</strong> @(Model.CopiedToPlex ? "Yes" : "No")
                </p>
            </div>
        </div>

        <form asp-action="Delete" method="post" class="mt-3">
            <input type="hidden" asp-for="MovieId" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="MovieList" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
